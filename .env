# ==============================
# Application Configuration
# ==============================
# Server port setting - Use environment PORT if provided
PORT=${PORT:-5000}
FLASK_SECRET_KEY=

# ==============================
# Google API Configuration
# ==============================
PORT=5000
FLASK_DEBUG=false

# Redis 設定 (用於持久化憑證存儲)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Google API 設定
USE_SERVICE_ACCOUNT=false  # 設為 true 時強制使用服務帳號
GOOGLE_SA_JSON_PATH=/home/mini/audio-processor/credentials/service-account.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:${PORT}/api/auth/google/callback

# ==============================
# Gemini API Configuration
# ==============================
GEMINI_API_KEY=

# Hugging Face 設定 (用於 pyannote.audio)
HF_TOKEN=

# Notion API 設定
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ==============================
# Optional Configurations
# ==============================
# Optional: Enable Docker Compose bake for better build performance
COMPOSE_BAKE=true

# GitHub Configuration
# Replace with your actual GitHub personal access token
GITHUB_TOKEN=your_github_token_here
# Replace with your actual repository (format: username/repository-name)
GITHUB_REPO=your_username/your_repo_name
GITHUB_PATH=notes/Meeting-Minutes
GITHUB_BRANCH=ming-v1.0.0
GITHUB_FILENAME_TEMPLATE=MM-YYYYMMDD.md